#compdef parley
# parley zsh completion - generated from the declared tables (CLI verbRows,
# CommandLine sourceFlags, modeFlags, publishLayouts, the question flags); do not edit by hand.
# environment: PARLEY_SOURCE, PARLEY_GIT, PARLEY_INDEX (flag > environment > parley.config.st)
_arguments \
    '--source:directory:_files' \
    '--git:repository:_files' \
    '--index:base:_files' \
    '--offline' \
    '--locked' \
    '--layout:layout:(flat sparse)' \
    '--version' \
    '--help' \
    '-h' \
    '1:verb:(init exec publish why update add remove resolve install search info outdated tree check)' \
    '*::arguments:_files'
